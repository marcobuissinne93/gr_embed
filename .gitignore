# --- Dependencies ---------------------------------------------------------
# Restored with `npm install` from package-lock.json, which IS committed.
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions

# --- Build output ---------------------------------------------------------
# `npm run build` regenerates these; nothing here should be reviewed or merged.
dist/
dist-ssr/
build/

# --- Caches ---------------------------------------------------------------
.vite/
.eslintcache
*.tsbuildinfo
coverage/
.nyc_output/

# --- Logs -----------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment ----------------------------------------------------------
# Secrets must never be committed. Commit a .env.example instead if the build
# ever needs configuring.
.env
.env.local
.env.*.local
!.env.example

# Vite's convention for machine-local overrides of any config file.
*.local

# --- Editors and IDEs -----------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.sw?
*~

# --- OS artefacts ---------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
